{
  "name": "smlynski-app",
  "version": "2.0.0",
  "private": true,
  "description": "Static marketing website for Sebastian Młyński — Usługi Remontowo-Budowlane",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run optimize:images",
    "dev": "next dev",
    "build": "npm run optimize:images && npm run check:assets && next build",
    "optimize:images": "node scripts/optimize-images.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "npx serve out"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
