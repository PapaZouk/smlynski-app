{
  "name": "smlynski-app",
  "version": "2.0.0",
  "private": true,
  "description": "Static marketing website for Sebastian Młyński — Usługi Remontowo-Budowlane",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "npm run optimize:images",
    "dev": "next dev",
    "build": "npm run optimize:images && npm run check:content && next build",
    "optimize:images": "node scripts/optimize-images.mjs",
    "check:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run build && playwright test",
    "preview": "npx serve out",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,md,mdx}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  }
}
