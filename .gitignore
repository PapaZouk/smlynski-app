# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# env files — never commit secrets
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# IDE
.idea

# misc
.DS_Store
*.tsbuildinfo

# downloaded by `npm run preview` (npx serve)
.cache

# generated by `npm run optimize:images` (regenerated on every dev/build run)
public/optimized/
src/lib/image-manifest.json

# generated by `npm run generate:og` (social card + touch icon, see ADR 0017)
public/og-default.jpg
public/apple-touch-icon.png

# playwright (local smoke tests only — never runs on Vercel)
test-results/
playwright-report/
blob-report/

# vitepress (local docs server only — never built or deployed)
docs/.vitepress/dist/
docs/.vitepress/cache/
