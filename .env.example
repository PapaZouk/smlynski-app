# Skopiuj ten plik do .env.local i uzupełnij wartościami.
# Wszystkie klucze są publiczne (NEXT_PUBLIC_*) — trafiają do bundla
# klienta, więc nie umieszczaj tu żadnych sekretów.

# Google Analytics — identyfikator pomiarowy (np. G-XXXXXXXXXX).
# Jeśli pusty, skrypt Analytics nie jest w ogóle ładowany.
NEXT_PUBLIC_GA_ID=

# EmailJS — obsługa formularza kontaktowego (klucze publiczne).
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# Google Maps API key — mapa na stronie Kontakt.
# Jeśli pusty, wyświetla się stylizowany placeholder z instrukcją.
NEXT_PUBLIC_GMAPS_API_KEY=

# Google Search Console — token weryfikacji domeny (HTML tag method).
# Pobierz go z GSC (Ustawienia → Weryfikacja właściciela) i wklej tutaj;
# po buildzie na Vercel wystarczy przesłać sitemap.xml w panelu GSC.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
